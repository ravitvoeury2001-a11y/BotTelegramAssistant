# =================================================================
# Telegram Bot Assistant - Environment Configuration
# =================================================================
# Copy this file to .env and fill in your actual values:
#   copy .env.example .env (Windows CMD)
#   cp .env.example .env   (PowerShell / Linux)
# =================================================================

# [REQUIRED] Telegram Bot Token from @BotFather in Telegram
# Example: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [OPTIONAL] OpenAI API Key
# If omitted or left blank, the bot runs in smart offline assistant mode
OPENAI_API_KEY=

# [OPTIONAL] OpenAI Model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] Administrator Telegram User IDs (comma-separated integers)
# To find your ID, message @userinfobot or @raw_data_bot on Telegram
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# [OPTIONAL] Database filename or path
DATABASE_PATH=bot_assistant.db

# [OPTIONAL] Anti-spam rate limit per user in seconds (default: 2.0)
RATE_LIMIT_SECONDS=2.0

# [OPTIONAL] Conversation memory depth (number of previous messages per user)
MAX_MEMORY_MESSAGES=10

# [OPTIONAL] Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
